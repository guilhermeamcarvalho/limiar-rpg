# Copie para server/.env e preencha. O .env nunca vai para o Git.
# Em produção, estas variáveis vêm do serviço do systemd (ver #26).

# development, production ou test
NODE_ENV=development

PORT=3000
HOST=127.0.0.1

# Endereço que o navegador usa para abrir o app (no dev, o Vite)
BASE_URL=http://localhost:5173

# Assina os cookies de sessão. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcionais: sem elas, ficam em data/ na raiz do repositório
# DATABASE_PATH=
# UPLOADS_DIR=

# Login com Discord (#11). Sem as duas, o botão do Discord fica desligado.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# fatal, error, warn, info, debug, trace ou silent. Padrão: debug no dev, info em produção
# LOG_LEVEL=

# Erros no Sentry (#29). Sem elas, nada é enviado. SENTRY_DSN é o do projeto do servidor;
# SENTRY_DSN_CLIENT, o do navegador (entra no build pelo deploy e libera o envio na CSP).
# SENTRY_DSN=
# SENTRY_DSN_CLIENT=

# Versão publicada: o deploy escreve esta variável sozinho. Não preencha à mão.
# MEMBRANA_VERSAO=
