{
  "name": "@membrana/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrar.ts",
    "reset-senha": "node --env-file-if-exists=.env src/scripts/reset-senha.ts",
    "typecheck": "tsc -p .",
    "sentry:teste": "node --env-file-if-exists=.env src/scripts/testar-sentry.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@membrana/shared": "workspace:*",
    "@sentry/node": "^11.15.0",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "nanoid": "^6.0.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4"
  }
}
