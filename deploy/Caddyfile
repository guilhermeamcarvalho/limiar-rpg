# Caddy na frente do app: HTTPS automático (Let's Encrypt), compressão e cabeçalhos.
# Instalado em /etc/caddy/Caddyfile, com o domínio no lugar de membrana.exemplo.com
# (o preparar-servidor.sh faz a troca). Recarregar: sudo systemctl reload caddy
{
	# E-mail para avisos do Let's Encrypt (certificado perto de vencer, por exemplo).
	email admin@membrana.exemplo.com
}

membrana.exemplo.com {
	encode zstd gzip

	# Mapas até 20 MB e músicas até 15 MB (arquitetura técnica): um pouco de folga.
	request_body {
		max_size 25MB
	}

	# O reverse_proxy repassa WebSocket (a mesa, com Socket.IO) sem configuração extra.
	reverse_proxy 127.0.0.1:3000

	# O app já manda CSP, X-Frame-Options e afins (helmet). Aqui, o que é do HTTPS e do proxy.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), geolocation=(), payment=(), usb=()"
		-Server
		-Via
	}

	log {
		output file /var/log/caddy/membrana.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
