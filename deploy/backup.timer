# Dispara o backup todo dia às 4h (horário do servidor). Instalado como
# /etc/systemd/system/membrana-backup.timer. Próxima execução: systemctl list-timers membrana-backup
[Unit]
Description=Backup diário da MEMBRANA às 4h

[Timer]
OnCalendar=*-*-* 04:00:00
# Servidor desligado às 4h? Roda assim que ligar.
Persistent=true
RandomizedDelaySec=5min
Unit=membrana-backup.service

[Install]
WantedBy=timers.target
